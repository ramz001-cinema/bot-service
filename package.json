{
  "name": "bot-service",
  "version": "1.0.0",
  "description": "A telegram bot service for the cinema application that handles interactions with users through messaging platforms.",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node src/index.ts",
    "build": "tsc"
  },
