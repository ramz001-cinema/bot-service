{
  "name": "bot-service",
  "version": "1.0.0",
  "description": "A telegram bot service for the cinema application that handles interactions with users through messaging platforms.",
  "main": "dist/main.js",
  "scripts": {
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node src/main.ts",
    "build": "tsc",
    "dev": "nodemon"
  },
  "keywords": [
    "telegram",
    "bot"
  ],
  "author": "@Ramz001",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.18.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@ramz001-cinema/core": "^1.1.2",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "telegraf": "^4.16.3",
    "zod": "^4.4.3"
  }
}